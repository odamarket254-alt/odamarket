# Firebase Cloud Messaging (FCM) - Client Web Push Configuration
VITE_FIREBASE_API_KEY="AIzaSyB5HnhscH5dx9kB6Z_QwH-8597KGf1cZHU"
VITE_FIREBASE_AUTH_DOMAIN="odamarket-4cfaf.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="odamarket-4cfaf"
VITE_FIREBASE_STORAGE_BUCKET="odamarket-4cfaf.firebasestorage.app"
